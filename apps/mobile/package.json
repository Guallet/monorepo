{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "jest --watchAll",
    "credentials": "eas credentials",
    "credentials:android": "cd android && ./gradlew signingReport",
    "expo:prebuild": "npx expo prebuild",
    "expo:prebuild:clean": "npx expo prebuild --clean",
    "expo:prebuild:ios": "npx expo prebuild --platform ios",
    "expo:prebuild:android": "npx expo prebuild --platform android",
    "expo:prebuild:android:clean": "npx expo prebuild --platform android --clean",
    "expo:prebuild:ios:clean": "npx expo prebuild --platform ios --clean",
    "build:android": "expo run:android --variant release",
    "build:android:local": "eas build --platform android --local",
    "build:android:local:development": "eas build --platform android --profile development --local",
    "sitemap:android": "npx uri-scheme open exp://192.168.1.166:8081/--/_sitemap --android",
    "eas:android:development": "eas build --profile development --platform android",
    "eas:update-branch": "eas update --auto",
    "eas:env:push": "eas secret:push --scope project --env-file .env",
    "eas:env:pull": "eas env:pull --environment development"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.1",
    "@expo/vector-icons": "^15.0.2",
    "@guallet/api-client": "workspace:*",
    "@guallet/api-react": "workspace:*",
    "@guallet/auth": "workspace:*",
    "@guallet/money": "workspace:*",
    "@luna-ui/react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~55.0.4",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-linking": "~55.0.7",
    "expo-network": "^55.0.8",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-email-link": "^1.16.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.2",
    "vexo-analytics": "^1.5.3"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.9",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}