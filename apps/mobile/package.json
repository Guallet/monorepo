{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "jest --watchAll",
    "credentials": "eas credentials",
    "credentials:android": "cd android && ./gradlew signingReport",
    "expo:prebuild": "npx expo prebuild",
    "expo:prebuild:clean": "npx expo prebuild --clean",
    "expo:prebuild:ios": "npx expo prebuild --platform ios",
    "expo:prebuild:android": "npx expo prebuild --platform android",
    "expo:prebuild:android:clean": "npx expo prebuild --platform android --clean",
    "expo:prebuild:ios:clean": "npx expo prebuild --platform ios --clean",
    "build:android": "expo run:android --variant release",
    "build:android:local": "eas build --platform android --local",
    "build:android:local:development": "eas build --platform android --profile development --local",
    "sitemap:android": "npx uri-scheme open exp://192.168.1.166:8081/--/_sitemap --android",
    "eas:android:development": "eas build --profile development --platform android",
    "eas:update-branch": "eas update --auto",
    "eas:env:push": "eas secret:push --scope project --env-file .env",
    "eas:env:pull": "eas env:pull --environment development"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@guallet/api-client": "workspace:*",
    "@guallet/api-react": "workspace:*",
    "@guallet/auth": "workspace:*",
    "@luna-ui/react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^7.8.0",
    "@tanstack/react-query": "^5.90.2",
    "aes-js": "^3.1.2",
    "expo": "~54.0.12",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-email-link": "^1.16.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "vexo-analytics": "^1.5.3"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}