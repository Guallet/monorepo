{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "credentials": "eas credentials",
    "credentials:android": "cd android && ./gradlew signingReport",
    "expo:prebuild": "npx expo prebuild",
    "expo:prebuild:clean": "npx expo prebuild --clean",
    "expo:prebuild:ios": "npx expo prebuild --platform ios",
    "expo:prebuild:android": "npx expo prebuild --platform android",
    "expo:prebuild:android:clean": "npx expo prebuild --platform android --clean",
    "expo:prebuild:ios:clean": "npx expo prebuild --platform ios --clean",
    "build:android": "expo run:android --variant release",
    "build:android:local": "eas build --platform android --local",
    "build:android:local:development": "eas build --platform android --profile development --local",
    "sitemap:android": "npx uri-scheme open exp://192.168.1.166:8081/--/_sitemap --android",
    "eas:android:development": "eas build --profile development --platform android",
    "eas:update-branch": "eas update --auto",
    "eas:env:push": "eas secret:push --scope project --env-file .env",
    "eas:env:pull": "eas env:pull --environment development"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.4",
    "@expo/vector-icons": "15.0.2",
    "@guallet/api-client": "workspace:*",
    "@guallet/api-react": "workspace:*",
    "@guallet/auth": "workspace:*",
    "@guallet/ui-react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@sentry/react-native": "7.11.0",
    "@tanstack/react-query": "5.90.2",
    "aes-js": "3.1.2",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.10",
    "expo-network": "8.0.7",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-email-link": "1.16.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "vexo-analytics": "1.5.3"
  },
  "devDependencies": {
    "@types/aes-js": "3.1.4",
    "@types/react": "19.2.14",
    "typescript": "6.0.3"
  },
  "private": true
}
