meta {
  name: Send sign-in OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/email-otp/send-verification-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "you@example.com",
    "type": "sign-in"
  }
}

docs {
  Sends a one-time code to the given email address. The code expires
  after 5 minutes. Requires SMTP_* settings on the server; in local
  development without SMTP the code is logged by the email service.
}
