{
  "name": "api",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:init": "pnpm db:generate && pnpm db:migrate",
    "db:generate": "npx @better-auth/cli generate --config src/auth/better-auth.ts",
    "db:migrate": "npx @better-auth/cli migrate --config src/auth/better-auth.ts",
    "script:set-role": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/set-user-role.ts"
  },
  "engines": {
    "node": ">=24.20 <25"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@nestjs/axios": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "12.0.0",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "12.0.1",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "ai": "7.0.93",
    "axios": "1.20.0",
    "better-auth": "1.7.3",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "dayjs": "1.11.23",
    "graphql": "17.0.2",
    "handlebars": "4.7.9",
    "helmet": "8.3.0",
    "joi": "18.2.8",
    "nestjs-pino": "5.1.0",
    "nodemailer": "10.0.0",
    "pg": "8.23.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/__mocks__/@thallesp/nestjs-better-auth/index.js"
    }
  }
}