{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build && node scripts/fix-swagger-metadata.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "db:init": "pnpm db:generate && pnpm db:migrate",
    "db:generate": "npx @better-auth/cli generate --config src/auth/better-auth.ts",
    "db:migrate": "npx @better-auth/cli migrate --config src/auth/better-auth.ts",
    "script:set-role": "node --loader ts-node/esm scripts/set-user-role.ts"
  },
  "engines": {
    "node": ">=24.20 <25"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.48",
    "@nestjs/axios": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/event-emitter": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/typeorm": "12.0.1",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "ai": "6.0.201",
    "axios": "1.16.0",
    "better-auth": "1.6.11",
    "bullmq": "5.69.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "compression": "1.8.1",
    "dayjs": "1.11.19",
    "graphql": "16.12.0",
    "handlebars": "4.7.9",
    "helmet": "8.1.0",
    "joi": "18.2.1",
    "nestjs-pino": "4.5.0",
    "nodemailer": "9.0.1",
    "pg": "8.18.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.2.3",
    "@types/nodemailer": "7.0.9",
    "@types/supertest": "6.0.3",
    "dotenv": "16.6.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.1",
    "globals": "16.3.0",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.53.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^src/(.*)$": "<rootDir>/$1",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/__mocks__/@thallesp/nestjs-better-auth/index.js"
    }
  }
}
