<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background-color: #9C27B0; color: white; padding: 20px; text-align: center; }
      .content { background-color: #f9f9f9; padding: 20px; }
      .button-container { text-align: center; margin: 30px 0; }
      .magic-button { 
        display: inline-block;
        background-color: #9C27B0; 
        color: white; 
        padding: 15px 40px; 
        text-decoration: none; 
        border-radius: 5px;
        font-weight: bold;
        font-size: 16px;
      }
      .magic-button:hover { background-color: #7B1FA2; }
      .alt-link {
        background-color: #F3E5F5;
        padding: 15px;
        margin: 20px 0;
        border-radius: 5px;
        word-break: break-all;
        font-size: 12px;
        color: #666;
      }
      .warning { 
        background-color: #FFF3E0; 
        padding: 15px; 
        margin: 15px 0; 
        border-radius: 5px; 
        border-left: 4px solid #FF9800; 
      }
      .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>🔐 Sign in to Guallet</h1>
      </div>
      <div class="content">
        <p>Hello,</p>
        <p>You requested a magic link to sign in to your Guallet account. Click the button below to securely sign in:</p>
        
        <div class="button-container">
          <a href="{{url}}" class="magic-button">Sign In to Guallet</a>
        </div>
        
        <p style="text-align: center; color: #666; font-size: 14px;">This link expires in 10 minutes</p>
        
        <div class="warning">
          <strong>⚠️ Security Notice:</strong>
          <p style="margin: 5px 0 0 0;">If you didn't request this magic link, please ignore this email. This link can only be used once.</p>
        </div>
        
        <div class="alt-link">
          <strong>Having trouble with the button?</strong><br>
          Copy and paste this link into your browser:<br>
          {{url}}
        </div>
      </div>
      <div class="footer">
        <p>© {{year}} Guallet. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
