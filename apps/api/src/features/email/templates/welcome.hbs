<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Guallet</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #f7f7f8;
      color: #1f2937;
    "
  >
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center" style="padding: 32px 16px">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            style="max-width: 600px; background-color: #ffffff; border-radius: 12px"
          >
            <tr>
              <td style="padding: 32px">
                <h1 style="margin: 0 0 16px 0; font-size: 24px; line-height: 1.3">
                  Welcome to Guallet, {{userName}} 👋
                </h1>
                <p style="margin: 0 0 12px 0; font-size: 16px; line-height: 1.6">
                  Your account is ready and we've created a full set of default categories so you can start tracking your transactions right away.
                </p>
                <p style="margin: 0; font-size: 16px; line-height: 1.6">
                  Thanks for joining us.
                </p>
              </td>
            </tr>
          </table>
          <p style="margin: 16px 0 0 0; color: #6b7280; font-size: 12px">
            © {{year}} Guallet. All rights reserved.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
