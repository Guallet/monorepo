{
  "name": "mcp-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --type-aware --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@guallet/finance-core": "workspace:*",
    "express": "5.2.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "tsconfig": "workspace:*",
    "tsx": "4.20.6",
    "typescript": "workspace:*",
    "vitest": "workspace:*"
  }
}
