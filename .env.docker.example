# Docker Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_USER=guallet
POSTGRES_PASSWORD=guallet_password
POSTGRES_DB=guallet

# Redis Configuration
REDIS_PASSWORD=guallet_redis_password
# Set REDISCLI_AUTH for redis-cli to use password automatically
REDISCLI_AUTH=guallet_redis_password

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@guallet.local
PGADMIN_DEFAULT_PASSWORD=admin

# API Configuration
VITE_API_URL=http://localhost:5000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Database Connection (used by API service)
DATABASE_USERNAME=guallet
DATABASE_PASSWORD=guallet_password
DATABASE_NAME=guallet

# JWT Secret for API authentication (Required)
# Generate a secure random string for production
AUTH_JWT_SECRET=change-this-to-a-secure-random-string-in-production

# SUPABASE AUTH (Required)
VITE_SUPABASE_URL=<your-supabase-url>
VITE_SUPABASE_KEY=<your-supabase-anon-key>

# NORDIGEN (Required for bank integrations)
NORDIGEN_SECRET_ID=<your-nordigen-secret-id>
NORDIGEN_SECRET_KEY=<your-nordigen-secret-key>

# EMAIL (Optional - for email notifications)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=Guallet <no-reply@yourdomain.com>

# SENTRY (Optional - for error tracking)
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=<your-sentry-dsn>

# APITALLY (Optional - for API monitoring)
APITALLY_ENABLED=false
APITALLY_CLIENT_ID=<your-apitally-client-id>
APITALLY_ENV=prod
