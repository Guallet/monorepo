# Docker Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_URL=http://localhost:5000

# SUPABASE AUTH (Required)
VITE_SUPABASE_URL=<your-supabase-url>
VITE_SUPABASE_KEY=<your-supabase-anon-key>

# NORDIGEN (Required for bank integrations)
NORDIGEN_SECRET_ID=<your-nordigen-secret-id>
NORDIGEN_SECRET_KEY=<your-nordigen-secret-key>

# EMAIL (Optional - for email notifications)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=Guallet <no-reply@yourdomain.com>

# SENTRY (Optional - for error tracking)
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=<your-sentry-dsn>

# APITALLY (Optional - for API monitoring)
APITALLY_ENABLED=false
APITALLY_CLIENT_ID=<your-apitally-client-id>
APITALLY_ENV=prod
