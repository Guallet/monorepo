ENVIRONMENT=development
PORT=5000

ALLOWED_CORS_ORIGINS="http://localhost:3000"

# IMPORTANT: Change this to a strong, unique, random secret for each environment.
# Example: use at least 32 random characters; never commit real secrets to version control.
AUTH_JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# NORDIGEN CONFIGURATION
NORDIGEN_SECRET_ID=""
NORDIGEN_SECRET_KEY=""

#  SMTP CONFIGURATION
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM=""

#  APITALLY CONFIGURATION (optional) 
APITALLY_ENABLED=false
APITALLY_CLIENT_ID=""
APITALLY_ENV=""