ENVIRONMENT=development
PORT=5000

ALLOWED_CORS_ORIGINS="http://localhost:3000"

# BETTER AUTH
BETTER_AUTH_SECRET="run `openssl rand -base64 32` to generate a secure random secret"
BETTER_AUTH_BASE_URL="http://localhost:5000"

# NORDIGEN CONFIGURATION
NORDIGEN_SECRET_ID=""
NORDIGEN_SECRET_KEY=""

# USER CREDENTIALS (required by UserCredentialsService)
# Encrypts sensitive user settings, including provider credentials.
# Generate a base64-encoded 32-byte key with: openssl rand -base64 32
# Reuse the same key across restarts to keep stored credentials readable.
DATABASE_CREDENTIALS_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"

#  SMTP CONFIGURATION
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM=""

# NESTJS OBSERVE CONFIGURATION (optional)
NESTJS_OBSERVE_APP_KEY=""
NESTJS_OBSERVE_APP_SECRET=""
NESTJS_OBSERVE_SERVICE_ID="guallet-api"
