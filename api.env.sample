ENVIRONMENT=development
PORT=5000

ALLOWED_CORS_ORIGINS="http://localhost:3000"

# BETTER AUTH
BETTER_AUTH_SECRET="run `openssl rand -base64 32` to generate a secure random secret"
BETTER_AUTH_BASE_URL="http://localhost:5000"

# NORDIGEN CONFIGURATION
NORDIGEN_SECRET_ID=""
NORDIGEN_SECRET_KEY=""

# AI CONFIGURATION
DATABASE_CREDENTIALS_ENCRYPTION_KEY="run `openssl rand -base64 32` to generate a secure encryption key"

#  SMTP CONFIGURATION
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM=""

# NESTJS OBSERVE CONFIGURATION (optional)
NESTJS_OBSERVE_APP_KEY=""
NESTJS_OBSERVE_APP_SECRET=""
NESTJS_OBSERVE_SERVICE_ID="guallet-api"

# Transaction classification (user-provided decision API)
DECISION_ALLOW_HTTP=false
# Exact hostname:port destinations; IPv6 uses [address]:port. Empty denies private targets.
DECISION_PRIVATE_TARGETS=
# Optional exact hostname allowlist for all destinations.
DECISION_ALLOWED_HOSTS=
DECISION_REQUEST_TIMEOUT_MS=8000
DECISION_MAX_QUESTIONS=24
DECISION_REQUESTS_PER_MINUTE=60
