{
  "name": "@guallet/money",
  "version": "0.2.0",
  "description": "A common money, type-safe library for handling money and currency operations",
  "private": true,
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*"
  }
}
