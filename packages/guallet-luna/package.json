  },
  "dependencies": {
    "@guallet/theme": "workspace:*",
    "@tabler/icons-react": "3.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "workspace:*",
    "@types/react-dom": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*"
  }
