{
  "name": "@guallet/luna",
  "version": "0.1.0",
  "description": "Luna UI components and category icons for web",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
