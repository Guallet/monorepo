{
  "name": "@guallet/luna-ui",
  "version": "0.1.0",
  "description": "Guallet UI components for React Native",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#tabler/*": {
      "react-native": "@tabler/icons-react-native/*",
      "default": "@tabler/icons-react/dist/esm/icons/*.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    }
  },
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "cjgaliana",
  "dependencies": {
    "@guallet/theme": "workspace:*",
    "@tabler/icons-react": "3.46.0",
    "@tabler/icons-react-native": "3.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*"
  }
}
