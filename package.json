{
  "name": "guallet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:up:build": "docker-compose up -d --build",
    "docker:compose:down": "docker-compose down",
    "docker:compose:reset": "docker-compose down && docker-compose up -d"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@eslint/js": "^9.39.2",
      "@mantine/charts": "^8.2.7",
      "@mantine/core": "^8.2.7",
      "@mantine/dates": "^8.2.7",
      "@mantine/dropzone": "^8.2.7",
      "@mantine/form": "^8.2.7",
      "@mantine/hooks": "^8.2.7",
      "@mantine/modals": "^8.2.7",
      "@mantine/notifications": "^8.2.7",
      "@tabler/icons-react": "^3.31.0",
      "@tanstack/react-query": "^5.83.1",
      "@types/react": "^19.0.12",
      "@types/react-dom": "^19.0.4",
      "eslint": "^9.39.2",
      "eslint-config-next": "^16.1.1",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-only-warn": "^1.1.0",
      "eslint-plugin-prettier": "^5.2.2",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-react-refresh": "^0.4.26",
      "eslint-plugin-turbo": "^2.7.4",
      "eslint-config-turbo": "^2.7.4",
      "globals": "^16.0.0",
      "postcss": "^8.5.3",
      "postcss-preset-mantine": "^1.17.0",
      "postcss-simple-vars": "^7.0.1",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.53.0",
      "vite": "^7.3.1"
    }
  }
}