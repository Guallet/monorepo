{
  "name": "guallet",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:up:build": "docker-compose up -d --build",
    "docker:compose:down": "docker-compose down",
    "docker:compose:reset": "docker-compose down && docker-compose up -d"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "2.8.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@eslint/js": "9.39.2",
      "@mantine/charts": "9.0.0",
      "@mantine/core": "9.0.0",
      "@mantine/dates": "9.0.0",
      "@mantine/dropzone": "9.0.0",
      "@mantine/form": "9.0.0",
      "@mantine/hooks": "9.0.0",
      "@mantine/modals": "9.0.0",
      "@mantine/notifications": "9.0.0",
      "@tabler/icons-react": "3.34.0",
      "@tanstack/react-query": "5.90.2",
      "@types/jest": "30.0.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "better-auth": "1.4.18",
      "eslint": "9.39.2",
      "eslint-config-next": "16.1.1",
      "eslint-config-prettier": "10.1.8",
      "eslint-config-turbo": "2.7.4",
      "eslint-plugin-only-warn": "1.1.0",
      "eslint-plugin-prettier": "5.5.1",
      "eslint-plugin-react": "7.37.5",
      "eslint-plugin-react-hooks": "7.0.1",
      "eslint-plugin-react-refresh": "0.4.26",
      "eslint-plugin-turbo": "2.7.4",
      "globals": "16.3.0",
      "jest": "30.2.0",
      "postcss": "8.5.6",
      "postcss-preset-mantine": "1.18.0",
      "postcss-simple-vars": "7.0.1",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "ts-jest": "29.4.6",
      "typescript": "5.9.3",
      "typescript-eslint": "8.53.0",
      "vite": "8.0.3"
    }
  }
}
